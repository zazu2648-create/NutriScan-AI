# GEMINI_API_KEY: Required for Gemini AI API calls (Photo Food Scanner & Nutrition Label OCR).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# USDA_FDC_API_KEY: Optional API key for USDA FoodData Central API (https://fdc.nal.usda.gov/api-key-signup.html).
# Falls back to DEMO_KEY when not configured, with lower rate limits.
USDA_FDC_API_KEY="DEMO_KEY"

# AUTH_SECRET: Secret key used on the backend to sign session tokens.
# If omitted, the server auto-generates a persistent local secret in data/.auth_secret.
AUTH_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
