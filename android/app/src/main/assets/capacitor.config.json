{
	"appId": "com.nutriscanai.app",
	"appName": "NutriScan AI",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"android": {
		"allowMixedContent": false,
		"backgroundColor": "#14532D"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1500,
			"backgroundColor": "#14532D",
			"showSpinner": false
		},
		"LocalNotifications": {
			"smallIcon": "ic_launcher",
			"iconColor": "#15803D"
		}
	}
}
